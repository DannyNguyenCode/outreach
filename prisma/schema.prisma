  INVITATION_CREATED
  INVITATION_REPLACED
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  MEMBER_ROLE_CHANGED
  MEMBER_DEACTIVATED
  BUSINESS_PROFILE_UPDATED
  OPERATING_HOURS_UPDATED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DEACTIVATED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DEACTIVATED
  ORGANIZATION_SETTINGS_UPDATED
  ONBOARDING_STARTED
  ONBOARDING_COMPLETED
  ONBOARDING_REOPENED
  BUSINESS_TEMPLATE_SELECTED
  BUSINESS_TEMPLATE_SWITCHED
  CUSTOM_FIELD_CREATED
  CUSTOM_FIELD_UPDATED
  CUSTOM_FIELD_DEACTIVATED
  CUSTOM_FIELDS_REORDERED
  SERVICE_AREA_CREATED
  SERVICE_AREA_UPDATED
  SERVICE_AREA_DEACTIVATED
  HOLIDAY_CLOSURE_CREATED
  HOLIDAY_CLOSURE_UPDATED
  HOLIDAY_CLOSURE_DEACTIVATED
  OPERATIONAL_DEFAULTS_UPDATED
  LEAD_STAGES_UPDATED
  CALL_DISPOSITIONS_UPDATED
  ORGANIZATION_LOCALE_UPDATED
  CONFIG_PROGRESS_UPDATED
  KNOWLEDGE_SOURCE_CREATED
  KNOWLEDGE_DRAFT_UPDATED
  KNOWLEDGE_REPLACEMENT_DRAFT_CREATED
  KNOWLEDGE_VERSION_CONFIRMED
  KNOWLEDGE_SOURCE_ARCHIVED
  KNOWLEDGE_VERSION_RESTORED
  KNOWLEDGE_DOCUMENT_UPLOAD_INITIATED
  KNOWLEDGE_DOCUMENT_UPLOAD_FINALIZED
  KNOWLEDGE_DOCUMENT_UPLOAD_FAILED
  KNOWLEDGE_DOCUMENT_UPLOAD_CLEANED
  KNOWLEDGE_DOCUMENT_SCAN_COMPLETED
  KNOWLEDGE_DOCUMENT_PROCESSING_COMPLETED
  KNOWLEDGE_DOCUMENT_PROCESSING_FAILED
  KNOWLEDGE_DOCUMENT_RETRY_REQUESTED
  KNOWLEDGE_DOCUMENT_CORRECTIONS_SAVED
  KNOWLEDGE_DOCUMENT_DUPLICATE_ACKNOWLEDGED
  KNOWLEDGE_DOCUMENT_CONFIRMED
  KNOWLEDGE_DOCUMENT_REPLACED
  OFFERING_DRAFT_CREATED
  OFFERING_DRAFT_UPDATED
  OFFERING_REPLACEMENT_DRAFT_CREATED
  OFFERING_PRICE_CHANGED
  OFFERING_VERSION_CONFIRMED
  OFFERING_SUPERSEDED
  OFFERING_ARCHIVED
  OFFERING_RESTORED
  CSV_IMPORT_STAGED
  CSV_IMPORT_ACTIVATED
  PROSPECT_CREATED
  PROSPECT_UPDATED
  PROSPECT_ARCHIVED
  PROSPECT_RESTORED
  PROSPECT_MERGED
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_ARCHIVED
}

enum BusinessType {
  SERVICES
  PRODUCTS
  BOTH
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  WEBSITE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum OnboardingStep {
  BUSINESS_BASICS
  CONTACT_LOCATION
  OPERATING_HOURS
  CATALOGUE
  EMPLOYEE_DEFAULTS
  REVIEW
}

/// Generic default for future calling features. Does not grant telephony access.
enum FutureCallingAccessDefault {
  DISABLED
  STANDARD
}

/// Platform business-template keys (Phase 3B). Definitions live in typed server code.
enum BusinessTemplateKey {
  PROFESSIONAL_SERVICES
  HOME_TRADE_SERVICES
  PRODUCT_BUSINESS
  SUBSCRIPTIONS_PLANS
  APPOINTMENT_BASED
  CUSTOM_MIXED
}

enum CustomFieldDataType {
  TEXT
  LONG_TEXT
  NUMBER
  BOOLEAN
  DATE
  SINGLE_SELECT
  MULTI_SELECT
  URL
  EMAIL
  PHONE
}

/// Intended use of a custom-field definition. Values are never stored in Phase 3B.
enum CustomFieldScope {
  BUSINESS
  OFFERING
  PROSPECT
  CONTACT
  KNOWLEDGE
}

enum LeadStageClassification {
  NONE
  INITIAL
  WON
  LOST
  TERMINAL
}

enum CallbackAssignmentBehavior {
  UNASSIGNED
  ROUND_ROBIN_PLACEHOLDER
  CREATOR
}

enum RecordingAccessDefault {
  ADMINS_ONLY
  ADMINS_AND_OWNERS
  ROLE_GATED_LATER
}

enum ConfigProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ConfigSection {
  BUSINESS_TEMPLATE
  LOCALE
  SERVICE_AREAS
  AVAILABILITY
  LEAD_STAGES
  CALL_DISPOSITIONS
  CALLBACK_POLICY
  RECORDING_CONSENT
  NOTIFICATIONS
  CUSTOM_FIELDS
  REVIEW
}

/// Tenant root for Phase 2 multi-organization support.
model Organization {
  id                      String                              @id @default(cuid())
  name                    String
  /// URL-safe unique slug. Normalized at write time; not silently rewritten on rename.
  slug                    String                              @unique
  createdAt               DateTime                            @default(now())
  updatedAt               DateTime                            @updatedAt
  memberships             Membership[]
  invitations             OrganizationInvitation[]
  auditEvents             OrganizationAuditEvent[]
  activeUsers             User[]                              @relation("UserActiveOrganization")
  businessProfile         BusinessProfile?
  businessLocations       BusinessLocation[]
  operatingHours          OperatingHourInterval[]
  services                BusinessService[]
  products                BusinessProduct[]
  settings                OrganizationSettings?
  onboarding              OrganizationOnboarding?
  templateAssignment      OrganizationTemplateAssignment?
  localeSettings          OrganizationLocaleSettings?
  callbackPolicy          OrganizationCallbackPolicy?
  recordingConsentPolicy  OrganizationRecordingConsentPolicy?
  notificationDefaults    OrganizationNotificationDefaults?
  configProgress          OrganizationConfigProgress?
  customFieldDefinitions  CustomFieldDefinition[]
  serviceAreas            ServiceArea[]
  holidayClosures         HolidayClosure[]
  leadStageDefaults       LeadStageDefault[]
  callDispositionDefaults CallDispositionDefault[]
  knowledgeSources        KnowledgeSource[]
  knowledgeDocuments      KnowledgeDocument[]
  knowledgeDocumentJobs   KnowledgeDocumentJob[]
  knowledgeDocumentIssues KnowledgeDocumentIssue[]
  offerings               Offering[]
  csvImports              CsvImport[]
  csvImportRows           CsvImportRow[]
  csvImportConfirmations  CsvImportConfirmation[]
  csvImportKnowledgeRowActivations CsvImportKnowledgeRowActivation[]
  csvImportOfferingRowActivations  CsvImportOfferingRowActivation[]
  prospects               Prospect[]
  prospectContacts        ProspectContact[]
  prospectChannels        ProspectChannel[]
  prospectCustomValues    ProspectCustomValue[]
  prospectContactCustomValues ProspectContactCustomValue[]
  prospectMerges          ProspectMerge[]

  @@index([createdAt])
}

/// User membership in an organization. One row per user per organization.
model Membership {
  id                  String           @id @default(cuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                OrganizationRole
  status              MembershipStatus @default(ACTIVE)
  deactivatedAt       DateTime?
  deactivatedByUserId String?
  deactivatedBy       User?            @relation("MembershipDeactivator", fields: [deactivatedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@index([organizationId, role, status])
}

/// Hashed, expiring, single-use organization invitation.
/// Raw tokens are emailed once and never stored.
model OrganizationInvitation {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailNormalized String
  role            OrganizationRole
  tokenHash       String           @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  invitedBy       User             @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  /// Partial unique index created in Phase 2 migration (one usable invite per org+email).

  @@index([organizationId, emailNormalized])
  @@index([expiresAt])
  @@index([organizationId, revokedAt, acceptedAt])
}

/// Focused audit trail for sensitive Phase 2+ organization actions.
model OrganizationAuditEvent {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actor          User?                   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action         OrganizationAuditAction
  /// Structured, minimal metadata. Never store secrets or raw tokens.
  metadata       Json?
  createdAt      DateTime                @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Singular business identity and contact configuration for an organization.
/// System organization name/slug remain on Organization; displayName is customer-facing.
model BusinessProfile {
  id                     String                  @id @default(cuid())
  organizationId         String                  @unique
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName              String?
  displayName            String?
  description            String?
  industry               String?
  websiteUrl             String?
  primaryEmail           String?
  /// E.164 when a valid country context exists; otherwise a normalized digit form.
  primaryPhoneE164       String?
  preferredContactMethod PreferredContactMethod?
  /// IANA time zone identifier (e.g. America/Toronto). Never a raw UTC offset.
  timeZone               String?
  businessType           BusinessType?
  /// Optional remote logo URL only â€” no file upload in Phase 3A.
  logoUrl                String?
  /// Optimistic concurrency token for profile updates.
  version                Int                     @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

/// Organization-owned location. Phase 3A manages one primary location;
/// additional non-primary rows may be added later without schema redesign.
model BusinessLocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String       @default("Primary")
  isPrimary      Boolean      @default(true)
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  /// ISO 3166-1 alpha-2 country code.
  countryCode    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  /// Partial unique index in migration: one primary location per organization.

  @@index([organizationId])
}

/// Normalized weekly operating-hour intervals.
/// Times are minutes from local midnight; start inclusive, end exclusive.
/// Overnight intervals (end <= start) are rejected. Closed days use isClosed=true
/// with null start/end and sortOrder 0.
model OperatingHourInterval {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dayOfWeek      DayOfWeek
  isClosed       Boolean      @default(false)
  startMinute    Int?
  endMinute      Int?
  sortOrder      Int          @default(0)
  customerNote   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, dayOfWeek, sortOrder])
  @@index([organizationId, dayOfWeek])
}

/// Organization service catalogue entry. Duplicate names are allowed within a tenant.
/// Prefer isActive=false over destructive deletion.
model BusinessService {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  isActive         Boolean      @default(true)
  displayOrder     Int          @default(0)
  priceDescription String?
  durationMinutes  Int?
  category         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  linkedOfferings  Offering[]   @relation("OfferingLegacyService")

  @@index([organizationId, displayOrder])
  @@index([organizationId, isActive, displayOrder])
}
/// SKU uniqueness is organization-scoped when sku is non-null (partial unique index).
model BusinessProduct {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  isActive         Boolean      @default(true)
  displayOrder     Int          @default(0)
  sku              String?
  priceDescription String?
  category         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  linkedOfferings  Offering[]   @relation("OfferingLegacyProduct")

  @@index([organizationId, displayOrder])
  @@index([organizationId, isActive, displayOrder])
}
model OrganizationSettings {
  id                         String                     @id @default(cuid())
  organizationId             String                     @unique
  organization               Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membersCanViewServices     Boolean                    @default(true)
  membersCanViewProducts     Boolean                    @default(true)
  membersCanViewBusinessInfo Boolean                    @default(true)
  futureCallingAccessDefault FutureCallingAccessDefault @default(DISABLED)
  version                    Int                        @default(0)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
}

/// Authoritative onboarding progress. URL/localStorage are never the source of truth.
model OrganizationOnboarding {
  id                   String           @id @default(cuid())
  organizationId       String           @unique
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status               OnboardingStatus @default(NOT_STARTED)
  currentStep          OnboardingStep   @default(BUSINESS_BASICS)
  /// JSON string array of completed OnboardingStep values (validated in application code).
  completedSteps       Json             @default("[]")
  /// Server-computed readiness for later Phase 3B prerequisites.
  isConfigurationReady Boolean          @default(false)
  completedAt          DateTime?
  completedByUserId    String?
  completedBy          User?            @relation("OnboardingCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  reopenedAt           DateTime?
  reopenedByUserId     String?
  reopenedBy           User?            @relation("OnboardingReopener", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  version              Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status])
}

/// Explicit organization selection of a platform business template.
/// Template examples never become customer facts; only confirmed customization is stored.
model OrganizationTemplateAssignment {
  id                        String              @id @default(cuid())
  organizationId            String              @unique
  organization              Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateKey               BusinessTemplateKey
  /// Version of the platform template definition at selection/switch time.
  templateDefinitionVersion Int
  /// Confirmed customization metadata only (labels, enabled suggested keys). Never auto-facts.
  customization             Json                @default("{}")
  selectedByUserId          String?
  selectedBy                User?               @relation("TemplateSelector", fields: [selectedByUserId], references: [id], onDelete: SetNull)
  selectedAt                DateTime            @default(now())
  version                   Int                 @default(0)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
}

/// Locale / language / display preferences. Distinct from BusinessProfile.timeZone.
model OrganizationLocaleSettings {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// BCP 47 locale tag (e.g. en-CA).
  locale                  String       @default("en-CA")
  /// BCP 47 language tag (e.g. en).
  defaultLanguage         String       @default("en")
  dateDisplayPreference   String       @default("locale")
  timeDisplayPreference   String       @default("locale")
  numberDisplayPreference String       @default("locale")
  version                 Int          @default(0)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

/// Organization-defined field definitions for later knowledge/CRM phases.
/// Phase 3B stores definitions only â€” never prospect or knowledge values.
model CustomFieldDefinition {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Stable key unique within organization + scope.
  key             String
  label           String
  description     String?
  dataType        CustomFieldDataType
  required        Boolean             @default(false)
  isActive        Boolean             @default(true)
  displayOrder    Int                 @default(0)
  /// Select options as validated JSON string array when applicable.
  options         Json?
  /// Optional validation constraints (min/max/pattern) as schema-validated JSON.
  validation      Json?
  scope           CustomFieldScope    @default(BUSINESS)
  version         Int                 @default(0)
  createdByUserId String?
  createdBy       User?               @relation("CustomFieldCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedBy       User?               @relation("CustomFieldUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  offeringValues  OfferingCustomValue[]
  prospectValues  ProspectCustomValue[]
  contactValues   ProspectContactCustomValue[]

  @@unique([organizationId, scope, key])
  @@unique([id, organizationId])
  @@index([organizationId, scope, displayOrder])
  @@index([organizationId, isActive, displayOrder])
}

/// Geographic / remote service coverage labels. No geometry or geocoding in Phase 3B.
model ServiceArea {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  /// ISO 3166-1 alpha-2 when applicable.
  countryCode    String?
  /// Normalized region/province/state code or label.
  region         String?
  city           String?
  /// Bounded postal/ZIP prefix (digits/letters + optional hyphen), never unbounded wildcards.
  postalPrefix   String?
  isRemote       Boolean      @default(false)
  isActive       Boolean      @default(true)
  displayOrder   Int          @default(0)
  version        Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, displayOrder])
  @@index([organizationId, isActive, displayOrder])
}

/// Exceptional availability separate from weekly OperatingHourInterval rows.
/// Dates are local calendar dates in the organization's IANA timezone.
model HolidayClosure {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Local calendar start date YYYY-MM-DD (organization timezone).
  localDateStart       String
  /// Optional inclusive local end date for a bounded range.
  localDateEnd         String?
  isClosedAllDay       Boolean      @default(true)
  /// Optional replacement opening intervals [{startMinute,endMinute}] half-open.
  replacementIntervals Json?
  customerNote         String?
  internalLabel        String?
  isActive             Boolean      @default(true)
  version              Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId, localDateStart])
  @@index([organizationId, isActive, localDateStart])
}

/// Organization-configured lead stages for later CRM. No prospect records here.
model LeadStageDefault {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  label          String
  isActive       Boolean                 @default(true)
  displayOrder   Int                     @default(0)
  classification LeadStageClassification @default(NONE)
  isDefault      Boolean                 @default(false)
  version        Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, displayOrder])
}

/// Organization-configured call dispositions for later calling. No call records here.
model CallDispositionDefault {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key             String
  label           String
  isActive        Boolean      @default(true)
  displayOrder    Int          @default(0)
  expectsFollowUp Boolean      @default(false)
  isTerminal      Boolean      @default(false)
  version         Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, displayOrder])
}

/// Future workflow callback defaults. Not a scheduler.
model OrganizationCallbackPolicy {
  id                        String                     @id @default(cuid())
  organizationId            String                     @unique
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Default suggested callback window length in minutes.
  defaultWindowMinutes      Int                        @default(60)
  maxSuggestedAttempts      Int                        @default(3)
  minSpacingMinutes         Int                        @default(120)
  businessHoursOnly         Boolean                    @default(true)
  defaultAssignmentBehavior CallbackAssignmentBehavior @default(UNASSIGNED)
  version                   Int                        @default(0)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

/// Recording / transcription / retention / consent policy defaults.
/// Configuration only â€” not legal approval; recording/transcription default OFF.
model OrganizationRecordingConsentPolicy {
  id                        String                 @id @default(cuid())
  organizationId            String                 @unique
  organization              Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordingEnabled          Boolean                @default(false)
  transcriptionEnabled      Boolean                @default(false)
  consentCaptureRequired    Boolean                @default(true)
  /// Placeholder text for later disclosure workflows â€” not legal advice.
  disclosureTextPlaceholder String?
  /// Retention duration in days within reviewed bounds.
  retentionDays             Int                    @default(30)
  accessDefault             RecordingAccessDefault @default(ADMINS_ONLY)
  reviewRequired            Boolean                @default(true)
  version                   Int                    @default(0)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
}

/// Notification and escalation configuration metadata only (no Slack/SMS/telephony).
model OrganizationNotificationDefaults {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  escalationContactLabel String?
  escalationContactEmail String?
  /// Enabled notification category keys (validated).
  notificationCategories Json         @default("[]")
  /// Delivery channels already supported by the app (e.g. in_app, email).
  enabledChannels        Json         @default("[\"in_app\"]")
  /// Optional operational threshold placeholders.
  thresholdPlaceholders  Json         @default("{}")
  version                Int          @default(0)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

/// Bounded Phase 3B configuration progress. Independent of OrganizationOnboarding.
model OrganizationConfigProgress {
  id                String               @id @default(cuid())
  organizationId    String               @unique
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status            ConfigProgressStatus @default(NOT_STARTED)
  currentSection    ConfigSection        @default(BUSINESS_TEMPLATE)
  /// JSON string array of completed ConfigSection values.
  completedSections Json                 @default("[]")
  updatedByUserId   String?
  updatedBy         User?                @relation("ConfigProgressUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  version           Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status])
}

/// How knowledge entered the workspace. Phase 4A persists MANUAL only.
enum KnowledgeInputKind {
  MANUAL
  DOCUMENT
}

enum KnowledgeDocumentScanState {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum KnowledgeDocumentProcessingState {
  UPLOADING
  QUEUED
  SCANNING
  EXTRACTING
  NEEDS_ATTENTION
  COMPLETE
  FAILED
  ABANDONED
}

enum KnowledgeDocumentJobState {
  QUEUED
  RUNNING
  RETRY
  SUCCEEDED
  FAILED
}

enum KnowledgeDocumentIssueSeverity {
  WARNING
  BLOCKING
}

/// Source-class labels (KNOW-004). Phase 4A may activate only customer-confirmed facts.
enum KnowledgeSourceCategory {
  CUSTOMER_CONFIRMED_BUSINESS_FACTS
  PLATFORM_MAINTAINED_GUIDANCE
  PROSPECT_EVIDENCE
  CRM_HISTORY
  CALLER_STATEMENTS
  REPRESENTATIVE_NOTES
  LIVE_OPERATIONAL_DATA
  AI_INFERENCES
}

/// Shared Phase 4 lifecycle. Manual 4A writers use DRAFT/ACTIVE/SUPERSEDED/ARCHIVED.
enum KnowledgeLifecycleState {
  DRAFT
  PROCESSING
  NEEDS_ATTENTION
  ACTIVE
  SUPERSEDED
  ARCHIVED
  FAILED
}

/// Organization-owned logical knowledge identity. Versions are immutable once confirmed.
model KnowledgeSource {
  id               String                  @id @default(cuid())
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inputKind        KnowledgeInputKind      @default(MANUAL)
  category         KnowledgeSourceCategory
  /// Denormalized title promoted from a version only on confirmation.
  /// Draft updates do not overwrite this while an ACTIVE version exists.
  title            String
  archivedAt       DateTime?
  archivedByUserId String?
  archivedBy       User?                   @relation("KnowledgeSourceArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  createdByUserId  String?
  createdBy        User?                   @relation("KnowledgeSourceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// OCC for source-level archive / restore / replacement-draft creation.
  version          Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  versions         KnowledgeVersion[]
  csvImportRowActivations CsvImportKnowledgeRowActivation[]

  @@unique([id, organizationId])
  @@index([organizationId, archivedAt])
  @@index([organizationId, category])
  @@index([organizationId, title])
}

/// Immutable confirmed content identity. Drafts may be updated until confirmation.
/// PostgreSQL (not Prisma) also enforces:
/// - composite FKs `supersedesVersionId`/`restoredFromVersionId` â†’ (id, organizationId, sourceId)
///   ON DELETE NO ACTION, same organization and same source only
/// - effectiveUntil > effectiveFrom when both are set
/// - confirmation fields are all-null or all-present
/// - ACTIVE/SUPERSEDED require confirmation metadata; DRAFT forbids it
/// Confirmer identity is retained with ON DELETE RESTRICT. Membership
/// deactivation and demotion do not rewrite confirmation evidence.
model KnowledgeVersion {
  id                          String                   @id @default(cuid())
  organizationId              String
  sourceId                    String
  source                      KnowledgeSource          @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  state                       KnowledgeLifecycleState
  title                       String
  contentChecksum             String
  effectiveFrom               DateTime?                @db.Timestamptz(3)
  effectiveUntil              DateTime?                @db.Timestamptz(3)
  /// OCC for draft updates and confirmation. Frozen after confirmation.
  draftRevision               Int                      @default(0)
  createdByUserId             String?
  createdBy                   User?                    @relation("KnowledgeVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  confirmerUserId             String?
  /// Retained confirmer identity. Hard-delete of this user is rejected until a
  /// future retention/anonymization workflow safely replaces the reference.
  confirmer                   User?                    @relation("KnowledgeVersionConfirmer", fields: [confirmerUserId], references: [id], onDelete: Restrict)
  confirmedAt                 DateTime?
  confirmationLanguageVersion String?
  /// Previous active version this confirmation replaced, if any.
  /// SQL-only composite FK to (id, organizationId, sourceId); Prisma cannot
  /// declare a second relation on these shared scalar columns.
  supersedesVersionId         String?
  /// Historical version this draft was restored from, if any.
  /// SQL-only composite FK to (id, organizationId, sourceId); Prisma cannot
  /// declare a second relation on these shared scalar columns.
  restoredFromVersionId       String?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  sections                    KnowledgeSection[]
  document                    KnowledgeDocument?
  documentJobs                KnowledgeDocumentJob[]
  documentIssues              KnowledgeDocumentIssue[]
  csvImportRowActivations     CsvImportKnowledgeRowActivation[]

  @@unique([id, organizationId])
  @@unique([id, organizationId, sourceId])
  @@index([organizationId, state])
  @@index([sourceId, state])
  @@index([organizationId, state, effectiveFrom])
  @@index([contentChecksum])
}

model KnowledgeSection {
  id             String             @id @default(cuid())
  organizationId String
  sourceId       String
  versionId      String
  version        KnowledgeVersion   @relation(fields: [versionId, organizationId, sourceId], references: [id, organizationId, sourceId], onDelete: Cascade)
  citationKey    String
  title          String
  displayOrder   Int
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  passages       KnowledgePassage[]

  @@unique([versionId, citationKey])
  @@unique([versionId, displayOrder])
  @@unique([id, organizationId, sourceId, versionId])
  @@index([organizationId, versionId, displayOrder])
  @@index([sourceId])
}

model KnowledgePassage {
  id             String           @id @default(cuid())
  organizationId String
  sourceId       String
  versionId      String
  sectionId      String
  section        KnowledgeSection @relation(fields: [sectionId, organizationId, sourceId, versionId], references: [id, organizationId, sourceId, versionId], onDelete: Cascade)
  citationKey    String
  body           String
  displayOrder   Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([sectionId, citationKey])
  @@unique([sectionId, displayOrder])
  @@index([organizationId, versionId])
  @@index([sourceId])
}

/// Private storage metadata and durable processing state for one DOCUMENT
/// knowledge version. File bytes remain in private object storage.
model KnowledgeDocument {
  id                        String                           @id @default(cuid())
  organizationId            String
  sourceId                  String
  versionId                 String                           @unique
  organization              Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version                   KnowledgeVersion                 @relation(fields: [versionId, organizationId, sourceId], references: [id, organizationId, sourceId], onDelete: Cascade)
  originalFilename          String
  displayFilename           String
  storageBucket             String
  storageObjectKey          String                           @unique
  declaredMimeType          String
  detectedMimeType          String?
  byteSize                  BigInt?
  binaryChecksum            String?
  normalizedContentChecksum String?
  objectVersion             String?
  objectEtag                String?
  uploadedByUserId          String
  uploadedBy                User                             @relation("KnowledgeDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  uploadedAt                DateTime                         @default(now())
  finalizedAt               DateTime?
  scanState                 KnowledgeDocumentScanState       @default(PENDING)
  scannedChecksum           String?
  scannerName               String?
  scannerVersion            String?
  scannedAt                 DateTime?
  processingState           KnowledgeDocumentProcessingState @default(UPLOADING)
  processingAttempts        Int                              @default(0)
  leaseOwner                String?
  leaseExpiresAt            DateTime?
  retryAt                   DateTime?
  lastSafeErrorCode         String?
  extractorName             String?
  extractorVersion          String?
  exactDuplicateSourceId    String?
  exactDuplicateVersionId   String?
  nearDuplicateSourceId     String?
  nearDuplicateVersionId    String?
  duplicateAcknowledgedAt   DateTime?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  jobs                      KnowledgeDocumentJob[]
  issues                    KnowledgeDocumentIssue[]

  @@unique([id, organizationId, sourceId, versionId])
  @@unique([versionId, organizationId, sourceId])
  @@index([organizationId, binaryChecksum])
  @@index([organizationId, normalizedContentChecksum])
  @@index([organizationId, processingState, retryAt])
  @@index([processingState, leaseExpiresAt])
  @@index([organizationId, sourceId])
}

/// Minimal Phase 4B durable job. Phase 12 may generalize this contract.
model KnowledgeDocumentJob {
  id                String                    @id @default(cuid())
  organizationId    String
  sourceId          String
  versionId         String
  documentId        String
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version           KnowledgeVersion          @relation(fields: [versionId, organizationId, sourceId], references: [id, organizationId, sourceId], onDelete: Cascade)
  document          KnowledgeDocument         @relation(fields: [documentId, organizationId, sourceId, versionId], references: [id, organizationId, sourceId, versionId], onDelete: Cascade)
  idempotencyKey    String                    @unique
  state             KnowledgeDocumentJobState @default(QUEUED)
  attempts          Int                       @default(0)
  maxAttempts       Int                       @default(5)
  availableAt       DateTime                  @default(now())
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  lastSafeErrorCode String?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([id, organizationId])
  @@index([state, availableAt])
  @@index([state, leaseExpiresAt])
  @@index([organizationId, state, availableAt])
}

model KnowledgeDocumentIssue {
  id             String                         @id @default(cuid())
  organizationId String
  sourceId       String
  versionId      String
  documentId     String
  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version        KnowledgeVersion               @relation(fields: [versionId, organizationId, sourceId], references: [id, organizationId, sourceId], onDelete: Cascade)
  document       KnowledgeDocument              @relation(fields: [documentId, organizationId, sourceId, versionId], references: [id, organizationId, sourceId, versionId], onDelete: Cascade)
  code           String
  severity       KnowledgeDocumentIssueSeverity
  sectionLocator String?
  safeMessage    String
  resolvedAt     DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  @@unique([documentId, code, sectionLocator])
  @@index([organizationId, versionId, severity, resolvedAt])
}

/// Shared Phase 4C offering types. Not industry-specific.
enum OfferingType {
  PRODUCT
  SERVICE
  PLAN
  PACKAGE
  SUBSCRIPTION
  CUSTOM_QUOTE
}

enum OfferingPricingModel {
  NONE
  QUOTE_REQUIRED
  FIXED_ONE_TIME
  RECURRING
  MULTI_OPTION
  TIERED
}

enum OfferingLifecycleState {
  DRAFT
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum OfferingBillingFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

/// Logical organization offering identity. Versions are immutable once confirmed.
model Offering {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Denormalized name promoted from a version only on confirmation.
  name             String
  offeringType     OfferingType
  archivedAt       DateTime?
  archivedByUserId String?
  archivedBy       User?           @relation("OfferingArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  createdByUserId  String?
  createdBy        User?           @relation("OfferingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// Optional provenance link to Phase 3A operational catalogue rows.
  legacyServiceId  String?
  legacyService    BusinessService? @relation("OfferingLegacyService", fields: [legacyServiceId], references: [id], onDelete: SetNull)
  legacyProductId  String?
  legacyProduct    BusinessProduct? @relation("OfferingLegacyProduct", fields: [legacyProductId], references: [id], onDelete: SetNull)
  /// OCC for archive / restore / replacement-draft creation.
  version          Int             @default(0)
  displayOrder     Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  versions         OfferingVersion[]
  csvImportRowActivations CsvImportOfferingRowActivation[]

  @@unique([id, organizationId])
  @@unique([organizationId, legacyServiceId])
  @@unique([organizationId, legacyProductId])
  @@index([organizationId, archivedAt, displayOrder])
  @@index([organizationId, offeringType])
  @@index([organizationId, name])
}

/// Immutable confirmed offering snapshot. Drafts may be updated until confirmation.
model OfferingVersion {
  id                          String                 @id @default(cuid())
  organizationId              String
  offeringId                  String
  offering                    Offering               @relation(fields: [offeringId, organizationId], references: [id, organizationId], onDelete: Cascade)
  state                       OfferingLifecycleState
  name                        String
  description                 String?
  offeringType                OfferingType
  pricingModel                OfferingPricingModel
  quoteRequired               Boolean                @default(false)
  contentChecksum             String
  effectiveFrom               DateTime?              @db.Timestamptz(3)
  effectiveUntil              DateTime?              @db.Timestamptz(3)
  displayOrder                Int                    @default(0)
  /// OCC for draft updates and confirmation. Frozen after confirmation.
  draftRevision               Int                    @default(0)
  createdByUserId             String?
  createdBy                   User?                  @relation("OfferingVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  confirmerUserId             String?
  confirmer                   User?                  @relation("OfferingVersionConfirmer", fields: [confirmerUserId], references: [id], onDelete: Restrict)
  confirmedAt                 DateTime?
  confirmationLanguageVersion String?
  /// SQL-only composite FK to (id, organizationId, offeringId) in migration.
  supersedesVersionId         String?
  /// SQL-only composite FK to (id, organizationId, offeringId) in migration.
  restoredFromVersionId       String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  prices                      OfferingPrice[]
  features                    OfferingFeature[]
  variants                    OfferingVariant[]
  eligibility                 OfferingEligibility?
  customValues                OfferingCustomValue[]
  csvImportRowActivations     CsvImportOfferingRowActivation[]

  @@unique([id, organizationId])
  @@unique([id, organizationId, offeringId])
  @@index([organizationId, state])
  @@index([offeringId, state])
  @@index([organizationId, state, effectiveFrom])
  @@index([contentChecksum])
}

model OfferingPrice {
  id               String                    @id @default(cuid())
  organizationId   String
  offeringId       String
  versionId        String
  version          OfferingVersion           @relation(fields: [versionId, organizationId, offeringId], references: [id, organizationId, offeringId], onDelete: Cascade)
  label            String?
  /// Authoritative money amount. Never store JS floating-point as source of truth.
  amount           Decimal                   @db.Decimal(19, 4)
  /// ISO 4217 currency code.
  currencyCode     String                    @db.Char(3)
  billingFrequency OfferingBillingFrequency
  /// Optional interval multiplier for CUSTOM (and explicit counts).
  intervalCount    Int?
  isActive         Boolean                   @default(true)
  effectiveFrom    DateTime?                 @db.Timestamptz(3)
  effectiveUntil   DateTime?                 @db.Timestamptz(3)
  displayOrder     Int                       @default(0)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  variantPrices    OfferingVariantPrice[]

  @@unique([id, organizationId, offeringId, versionId])
  @@index([organizationId, versionId, isActive, displayOrder])
  @@index([organizationId, versionId, effectiveFrom])
}

model OfferingFeature {
  id             String          @id @default(cuid())
  organizationId String
  offeringId     String
  versionId      String
  version        OfferingVersion @relation(fields: [versionId, organizationId, offeringId], references: [id, organizationId, offeringId], onDelete: Cascade)
  /// Stable comparison key within a version.
  featureKey     String
  name           String
  value          String?
  unit           String?
  displayOrder   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([versionId, featureKey])
  @@unique([versionId, displayOrder])
  @@unique([id, organizationId, offeringId, versionId])
  @@index([organizationId, versionId, displayOrder])
}

model OfferingVariant {
  id             String                 @id @default(cuid())
  organizationId String
  offeringId     String
  versionId      String
  version        OfferingVersion        @relation(fields: [versionId, organizationId, offeringId], references: [id, organizationId, offeringId], onDelete: Cascade)
  name           String
  sku            String?
  referenceCode  String?
  /// Organization-defined attribute map validated in application code.
  attributes     Json                   @default("{}")
  isActive       Boolean                @default(true)
  displayOrder   Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  prices         OfferingVariantPrice[]

  @@unique([versionId, displayOrder])
  @@unique([id, organizationId, offeringId, versionId])
  @@index([organizationId, versionId, isActive, displayOrder])
}

model OfferingVariantPrice {
  id             String          @id @default(cuid())
  organizationId String
  offeringId     String
  versionId      String
  variantId      String
  priceId        String
  variant        OfferingVariant @relation(fields: [variantId, organizationId, offeringId, versionId], references: [id, organizationId, offeringId, versionId], onDelete: Cascade)
  price          OfferingPrice   @relation(fields: [priceId, organizationId, offeringId, versionId], references: [id, organizationId, offeringId, versionId], onDelete: Cascade)
  createdAt      DateTime        @default(now())

  @@unique([variantId, priceId])
  @@index([organizationId, versionId])
}

/// Conservative eligibility notes for the initial release. Not a rules engine.
model OfferingEligibility {
  id                       String          @id @default(cuid())
  organizationId           String
  offeringId               String
  versionId                String
  version                  OfferingVersion @relation(fields: [versionId, organizationId, offeringId], references: [id, organizationId, offeringId], onDelete: Cascade)
  description              String?
  availabilityRestrictions String?
  qualificationNotes       String?
  geographicNotes          String?
  minimumQuantity          Int?
  maximumQuantity          Int?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@unique([versionId])
  @@unique([versionId, organizationId, offeringId])
  @@unique([id, organizationId, offeringId, versionId])
  @@index([organizationId, versionId])
}

/// Typed custom values bound to Phase 3B OFFERING-scoped field definitions.
model OfferingCustomValue {
  id               String               @id @default(cuid())
  organizationId   String
  offeringId       String
  versionId        String
  definitionId     String
  version          OfferingVersion      @relation(fields: [versionId, organizationId, offeringId], references: [id, organizationId, offeringId], onDelete: Cascade)
  definition       CustomFieldDefinition @relation(fields: [definitionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  /// Stable key snapshot at write time.
  definitionKey    String
  stringValue      String?
  numberValue      Decimal?             @db.Decimal(19, 4)
  booleanValue     Boolean?
  dateValue        DateTime?            @db.Timestamptz(3)
  /// Validated JSON array/string for select types.
  jsonValue        Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([versionId, definitionId])
  @@unique([versionId, definitionKey])
  @@index([organizationId, versionId])
  @@index([organizationId, definitionId])
}

/// Phase 4D CSV import staging status. Incomplete/capped/timeout results
/// are never persisted. Confirmation is recorded on CsvImportConfirmation;
/// this status is immutable after staging.
enum CsvImportStatus {
  READY_TO_CONFIRM
  NEEDS_ATTENTION
}

enum CsvImportTargetFamily {
  KNOWLEDGE
  OFFERING
}

/// Organization-owned immutable snapshot of one complete CSV mapped validation.
/// Identity is server-derived from org, family, source checksum, canonical
/// mapping identity, and validation-contract version. Raw bytes are not stored.
/// PostgreSQL also enforces count/status consistency and rejects updates.
model CsvImport {
  id                         String                @id @default(cuid())
  organizationId             String
  organization               Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the server-owned identity material. Unique per organization.
  importIdentity             String
  targetFamily               CsvImportTargetFamily
  status                     CsvImportStatus
  filename                   String
  mimeType                   String
  byteLength                 Int
  sourceChecksum             String
  /// Canonical mapping JSON text. Not JSONB â€” insertion order is part of the contract.
  mappingJson                String                @db.Text
  mappingIdentity            String
  validationContractVersion  String
  totalRowCount              Int
  nonblankRowCount           Int
  validRowCount              Int
  invalidRowCount            Int
  skippedBlankRowCount       Int
  processedRowCount          Int
  issueCount                 Int
  createdByUserId            String
  createdBy                  User                  @relation("CsvImportCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt                  DateTime              @default(now())
  rows                       CsvImportRow[]
  confirmation               CsvImportConfirmation?
  knowledgeRowActivations    CsvImportKnowledgeRowActivation[]
  offeringRowActivations     CsvImportOfferingRowActivation[]

  @@unique([id, organizationId])
  @@unique([organizationId, importIdentity])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

/// Immutable ordered row snapshot for one staged CSV import.
/// valuesJson/issuesJson are canonical JSON text so PostgreSQL JSONB cannot
/// reorder object keys. Composite FK prevents cross-organization attachment.
model CsvImportRow {
  id             String      @id @default(cuid())
  organizationId String
  importId       String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  import         CsvImport    @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Cascade)
  displayOrder   Int
  sourceRowNumber Int
  valuesJson     String      @db.Text
  issuesJson     String      @db.Text
  createdAt      DateTime    @default(now())
  knowledgeActivation CsvImportKnowledgeRowActivation?
  offeringActivation  CsvImportOfferingRowActivation?

  @@unique([importId, displayOrder])
  @@unique([importId, sourceRowNumber])
  @@unique([id, organizationId, importId])
  @@index([organizationId, importId, displayOrder])
}

/// Immutable one-to-one confirmation receipt for a staged CSV import.
/// Domain activation is recorded here and in row provenance; the staged
/// CsvImport snapshot is never mutated.
model CsvImportConfirmation {
  id                          String                @id @default(cuid())
  organizationId              String
  importId                    String
  organization                Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  import                      CsvImport             @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Cascade)
  importIdentity              String
  sourceChecksum              String
  actorUserId                 String
  actor                       User                  @relation("CsvImportConfirmationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  confirmedAt                 DateTime
  confirmationLanguageVersion String
  targetFamily                CsvImportTargetFamily
  createdRowCount             Int
  /// Canonical JSON text. Not JSONB â€” insertion order is part of the contract.
  resultSummaryJson           String                @db.Text
  createdAt                   DateTime              @default(now())
  knowledgeRowActivations     CsvImportKnowledgeRowActivation[]
  offeringRowActivations      CsvImportOfferingRowActivation[]

  @@unique([importId])
  @@unique([id, organizationId])
  @@unique([importId, organizationId])
  @@index([organizationId, confirmedAt])
}

/// Organization-scoped provenance from one staged knowledge row to the
/// exact KnowledgeSource and KnowledgeVersion created at confirmation.
model CsvImportKnowledgeRowActivation {
  id                 String                @id @default(cuid())
  organizationId     String
  importId           String
  importRowId        String
  confirmationId     String
  knowledgeSourceId  String
  knowledgeVersionId String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  import             CsvImport             @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Cascade)
  importRow          CsvImportRow          @relation(fields: [importRowId, organizationId, importId], references: [id, organizationId, importId], onDelete: Cascade)
  confirmation       CsvImportConfirmation @relation(fields: [confirmationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  knowledgeSource    KnowledgeSource       @relation(fields: [knowledgeSourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  knowledgeVersion   KnowledgeVersion      @relation(fields: [knowledgeVersionId, organizationId, knowledgeSourceId], references: [id, organizationId, sourceId], onDelete: Restrict)
  createdAt          DateTime              @default(now())

  @@unique([importRowId])
  @@unique([importId, importRowId])
  @@unique([importRowId, organizationId, importId])
  @@unique([id, organizationId])
  @@index([organizationId, importId])
  @@index([organizationId, knowledgeSourceId])
}

/// Organization-scoped provenance from one staged offering row to the
/// exact Offering and OfferingVersion created at confirmation.
model CsvImportOfferingRowActivation {
  id                String                @id @default(cuid())
  organizationId    String
  importId          String
  importRowId       String
  confirmationId    String
  offeringId        String
  offeringVersionId String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  import            CsvImport             @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Cascade)
  importRow         CsvImportRow          @relation(fields: [importRowId, organizationId, importId], references: [id, organizationId, importId], onDelete: Cascade)
  confirmation      CsvImportConfirmation @relation(fields: [confirmationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  offering          Offering              @relation(fields: [offeringId, organizationId], references: [id, organizationId], onDelete: Restrict)
  offeringVersion   OfferingVersion       @relation(fields: [offeringVersionId, organizationId, offeringId], references: [id, organizationId, offeringId], onDelete: Restrict)
  createdAt         DateTime              @default(now())

  @@unique([importRowId])
  @@unique([importId, importRowId])
  @@unique([importRowId, organizationId, importId])
  @@unique([id, organizationId])
  @@index([organizationId, importId])
  @@index([organizationId, offeringId])
}

/// Phase 5A prospect identity kind. Not an industry taxonomy.
enum ProspectKind {
  BUSINESS
  INDIVIDUAL
  HOUSEHOLD
  ORGANIZATION
}

/// Phase 5A lifecycle. MERGED is a durable losing-record state, not a delete.
enum ProspectLifecycle {
  ACTIVE
  ARCHIVED
  MERGED
}

/// How the prospect entered Outreach. Phase 5A persists MANUAL only.
/// Later phases may add enum values without redesigning identity columns.
enum ProspectSourceKind {
  MANUAL
}

enum ProspectChannelKind {
  PHONE
  EMAIL
}

enum ProspectContactLifecycle {
  ACTIVE
  ARCHIVED
}

/// Organization-scoped canonical CRM prospect. Not every row is a business.
model Prospect {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind                   ProspectKind       @default(BUSINESS)
  displayName            String
  /// Lowercased, punctuation-stripped name used for deterministic matching.
  searchName             String
  websiteDisplay         String?
  /// Lowercased hostname without a leading www. Null when no website.
  websiteNormalized      String?
  locationLabel          String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  region                 String?
  postalCode             String?
  countryCode            String?
  timeZone               String?
  sourceKind             ProspectSourceKind @default(MANUAL)
  /// Reserved for later provenance keys (import id, connector id). Never freeform notes.
  sourceDetail           String?
  lifecycle              ProspectLifecycle  @default(ACTIVE)
  version                Int                @default(0)
  createdByUserId        String
  createdBy              User               @relation("ProspectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId        String
  updatedBy              User               @relation("ProspectUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  archivedAt             DateTime?
  archivedByUserId       String?
  archivedBy             User?              @relation("ProspectArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  restoredAt             DateTime?
  restoredByUserId       String?
  restoredBy             User?              @relation("ProspectRestorer", fields: [restoredByUserId], references: [id], onDelete: SetNull)
  mergedAt               DateTime?
  mergedIntoProspectId   String?
  mergedInto             Prospect?          @relation("ProspectMergeSurvivor", fields: [mergedIntoProspectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  mergedFrom             Prospect[]         @relation("ProspectMergeSurvivor")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  contacts               ProspectContact[]
  channels               ProspectChannel[]
  customValues           ProspectCustomValue[]
  contactCustomValues    ProspectContactCustomValue[]
  mergesAsSurvivor       ProspectMerge[]    @relation("ProspectMergeSurvivorRecord")
  mergesAsDuplicate      ProspectMerge[]    @relation("ProspectMergeDuplicateRecord")
  /// Self-merge and MERGED-without-survivor checks live in the migration.

  @@unique([id, organizationId])
  @@index([organizationId, lifecycle, updatedAt])
  @@index([organizationId, searchName])
  @@index([organizationId, websiteNormalized])
  @@index([organizationId, sourceKind])
  @@index([mergedIntoProspectId, organizationId])
}

/// Person associated with a prospect. One prospect may have many contacts.
model ProspectContact {
  id                  String                    @id @default(cuid())
  organizationId      String
  prospectId          String
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect            Prospect                  @relation(fields: [prospectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  firstName           String
  lastName            String
  displayName         String
  title               String?
  /// BCP 47 language tag when provided.
  preferredLanguage   String?
  lifecycle           ProspectContactLifecycle  @default(ACTIVE)
  isPrimary           Boolean                   @default(false)
  version             Int                       @default(0)
  createdByUserId     String
  createdBy           User                      @relation("ProspectContactCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId     String
  updatedBy           User                      @relation("ProspectContactUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  archivedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  channels            ProspectChannel[]
  customValues        ProspectContactCustomValue[]

  @@unique([id, organizationId])
  @@unique([id, organizationId, prospectId])
  @@index([organizationId, prospectId, isPrimary])
  @@index([organizationId, prospectId, lifecycle])
}

/// Canonical phone or email point. Future channel kinds can extend the enum.
/// A null contactId means the channel belongs to the prospect itself.
model ProspectChannel {
  id               String               @id @default(cuid())
  organizationId   String
  prospectId       String
  contactId        String?
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect         Prospect             @relation(fields: [prospectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contact          ProspectContact?     @relation(fields: [contactId, organizationId, prospectId], references: [id, organizationId, prospectId], onDelete: Restrict)
  kind             ProspectChannelKind
  /// User-facing label such as work, mobile, or main office.
  label            String?
  displayValue     String
  normalizedValue  String
  isPrimary        Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, kind, normalizedValue])
  @@index([organizationId, prospectId])
  @@index([organizationId, contactId])
}

/// Typed custom values bound to Phase 3B PROSPECT-scoped field definitions.
model ProspectCustomValue {
  id             String                 @id @default(cuid())
  organizationId String
  prospectId     String
  definitionId   String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect       Prospect               @relation(fields: [prospectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  definition     CustomFieldDefinition  @relation(fields: [definitionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  definitionKey  String
  stringValue    String?
  numberValue    Decimal?               @db.Decimal(19, 4)
  booleanValue   Boolean?
  dateValue      DateTime?              @db.Timestamptz(3)
  jsonValue      Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([prospectId, definitionId])
  @@unique([id, organizationId])
  @@index([organizationId, prospectId])
  @@index([organizationId, definitionId])
}

/// Typed custom values bound to CONTACT-scoped field definitions.
model ProspectContactCustomValue {
  id             String                 @id @default(cuid())
  organizationId String
  prospectId     String
  contactId      String
  definitionId   String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect       Prospect               @relation(fields: [prospectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contact        ProspectContact        @relation(fields: [contactId, organizationId, prospectId], references: [id, organizationId, prospectId], onDelete: Restrict)
  definition     CustomFieldDefinition  @relation(fields: [definitionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  definitionKey  String
  stringValue    String?
  numberValue    Decimal?               @db.Decimal(19, 4)
  booleanValue   Boolean?
  dateValue      DateTime?              @db.Timestamptz(3)
  jsonValue      Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([contactId, definitionId])
  @@unique([id, organizationId])
  @@index([organizationId, contactId])
  @@index([organizationId, prospectId])
  @@index([organizationId, definitionId])
}

/// Immutable merge receipt. The losing prospect row is preserved as MERGED.
model ProspectMerge {
  id                   String       @id @default(cuid())
  organizationId       String
  survivorProspectId   String
  mergedProspectId     String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  survivor             Prospect     @relation("ProspectMergeSurvivorRecord", fields: [survivorProspectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  merged               Prospect     @relation("ProspectMergeDuplicateRecord", fields: [mergedProspectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actorUserId          String
  actor                User         @relation("ProspectMergeActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  /// Canonical JSON text of explicit field resolutions. Not JSONB.
  fieldResolutionsJson String       @db.Text
  createdAt            DateTime     @default(now())

  @@unique([mergedProspectId])
  @@unique([id, organizationId])
  @@unique([organizationId, mergedProspectId])
  @@index([organizationId, survivorProspectId])
  @@index([organizationId, createdAt])
}
