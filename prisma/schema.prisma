generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Application user for Phase 1 email/password authentication.
/// passwordHash must never be selected by public-facing helpers.
model User {
  id                         String                           @id @default(cuid())
  name                       String
  /// Normalized lowercase email; uniqueness is case-insensitive by construction.
  email                      String                           @unique
  passwordHash               String
  emailVerifiedAt            DateTime?
  /// Incremented on password reset / explicit revocation to invalidate JWT sessions.
  sessionVersion             Int                              @default(0)
  /// Soft preference for the last selected organization. Always re-validated.
  activeOrganizationId       String?
  activeOrganization         Organization?                    @relation("UserActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  authTokens                 AuthToken[]
  memberships                Membership[]
  invitationsSent            OrganizationInvitation[]         @relation("InvitationInviter")
  membershipDeactivations    Membership[]                     @relation("MembershipDeactivator")
  auditEvents                OrganizationAuditEvent[]         @relation("AuditActor")
  onboardingsCompleted       OrganizationOnboarding[]         @relation("OnboardingCompleter")
  onboardingsReopened        OrganizationOnboarding[]         @relation("OnboardingReopener")
  templatesSelected          OrganizationTemplateAssignment[] @relation("TemplateSelector")
  customFieldsCreated        CustomFieldDefinition[]          @relation("CustomFieldCreator")
  customFieldsUpdated        CustomFieldDefinition[]          @relation("CustomFieldUpdater")
  configProgressUpdated      OrganizationConfigProgress[]     @relation("ConfigProgressUpdater")
  knowledgeSourcesCreated    KnowledgeSource[]                @relation("KnowledgeSourceCreator")
  knowledgeSourcesArchived   KnowledgeSource[]                @relation("KnowledgeSourceArchiver")
  knowledgeVersionsCreated   KnowledgeVersion[]               @relation("KnowledgeVersionCreator")
  /// Users referenced by immutable confirmation evidence cannot be hard-deleted
  /// until a future retention/anonymization workflow replaces that identity.
  knowledgeVersionsConfirmed KnowledgeVersion[]               @relation("KnowledgeVersionConfirmer")
  knowledgeDocumentsUploaded KnowledgeDocument[]              @relation("KnowledgeDocumentUploader")
  offeringsCreated           Offering[]                       @relation("OfferingCreator")
  offeringsArchived          Offering[]                       @relation("OfferingArchiver")
  offeringVersionsCreated    OfferingVersion[]                @relation("OfferingVersionCreator")
  offeringVersionsConfirmed  OfferingVersion[]                @relation("OfferingVersionConfirmer")
  csvImportsCreated          CsvImport[]                      @relation("CsvImportCreator")
  csvImportConfirmations     CsvImportConfirmation[]          @relation("CsvImportConfirmationActor")
  prospectsCreated           Prospect[]                       @relation("ProspectCreator")
  prospectsUpdated           Prospect[]                       @relation("ProspectUpdater")
  prospectsArchived          Prospect[]                       @relation("ProspectArchiver")
  prospectsRestored          Prospect[]                       @relation("ProspectRestorer")
  prospectContactsCreated    ProspectContact[]                @relation("ProspectContactCreator")
  prospectContactsUpdated    ProspectContact[]                @relation("ProspectContactUpdater")
  prospectMergesActor        ProspectMerge[]                  @relation("ProspectMergeActor")

  @@index([emailVerifiedAt])
  @@index([activeOrganizationId])
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// One-time tokens for email verification and password reset.
/// Only a cryptographic hash of the raw token is stored.
model AuthToken {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    AuthTokenPurpose
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  /// Partial unique index created in migration 20260810010000 (active tokens only).

  @@unique([purpose, tokenHash])
  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
  @@index([tokenHash])
}

/// Database-backed rate-limit counters suitable for serverless runtimes.
/// bucketKey is a hashed composite identity â€” never raw email or IP alone.
model RateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String   @unique
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

