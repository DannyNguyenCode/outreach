generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Phase 0 intentionally defines no application-domain models.
// Auth.js and product tables are introduced in later phases.
// Migrations remain version-controlled under prisma/migrations.
