generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Application user for Phase 1 email/password authentication.
/// passwordHash must never be selected by public-facing helpers.
model User {
  id                   String                    @id @default(cuid())
  name                 String
  /// Normalized lowercase email; uniqueness is case-insensitive by construction.
  email                String                    @unique
  passwordHash         String
  emailVerifiedAt      DateTime?
  /// Incremented on password reset / explicit revocation to invalidate JWT sessions.
  sessionVersion       Int                       @default(0)
  /// Soft preference for the last selected organization. Always re-validated.
  activeOrganizationId String?
  activeOrganization   Organization?             @relation("UserActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  authTokens           AuthToken[]
  memberships          Membership[]
  invitationsSent      OrganizationInvitation[]  @relation("InvitationInviter")
  membershipDeactivations Membership[]           @relation("MembershipDeactivator")
  auditEvents          OrganizationAuditEvent[]  @relation("AuditActor")
  onboardingsCompleted OrganizationOnboarding[]  @relation("OnboardingCompleter")
  onboardingsReopened  OrganizationOnboarding[]  @relation("OnboardingReopener")
  templatesSelected    OrganizationTemplateAssignment[] @relation("TemplateSelector")
  customFieldsCreated  CustomFieldDefinition[]   @relation("CustomFieldCreator")
  customFieldsUpdated  CustomFieldDefinition[]   @relation("CustomFieldUpdater")
  configProgressUpdated OrganizationConfigProgress[] @relation("ConfigProgressUpdater")
  knowledgeSourcesCreated  KnowledgeSource[]  @relation("KnowledgeSourceCreator")
  knowledgeSourcesArchived KnowledgeSource[]  @relation("KnowledgeSourceArchiver")
  knowledgeVersionsCreated KnowledgeVersion[] @relation("KnowledgeVersionCreator")
  knowledgeVersionsConfirmed KnowledgeVersion[] @relation("KnowledgeVersionConfirmer")

  @@index([emailVerifiedAt])
  @@index([activeOrganizationId])
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// One-time tokens for email verification and password reset.
/// Only a cryptographic hash of the raw token is stored.
model AuthToken {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    AuthTokenPurpose
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  @@unique([purpose, tokenHash])
  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
  @@index([tokenHash])
  /// Partial unique index created in migration 20260810010000 (active tokens only).
}

/// Database-backed rate-limit counters suitable for serverless runtimes.
/// bucketKey is a hashed composite identity — never raw email or IP alone.
model RateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String   @unique
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationAuditAction {
  ORGANIZATION_CREATED
  INVITATION_CREATED
  INVITATION_REPLACED
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  MEMBER_ROLE_CHANGED
  MEMBER_DEACTIVATED
  BUSINESS_PROFILE_UPDATED
  OPERATING_HOURS_UPDATED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DEACTIVATED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DEACTIVATED
  ORGANIZATION_SETTINGS_UPDATED
  ONBOARDING_STARTED
  ONBOARDING_COMPLETED
  ONBOARDING_REOPENED
  BUSINESS_TEMPLATE_SELECTED
  BUSINESS_TEMPLATE_SWITCHED
  CUSTOM_FIELD_CREATED
  CUSTOM_FIELD_UPDATED
  CUSTOM_FIELD_DEACTIVATED
  CUSTOM_FIELDS_REORDERED
  SERVICE_AREA_CREATED
  SERVICE_AREA_UPDATED
  SERVICE_AREA_DEACTIVATED
  HOLIDAY_CLOSURE_CREATED
  HOLIDAY_CLOSURE_UPDATED
  HOLIDAY_CLOSURE_DEACTIVATED
  OPERATIONAL_DEFAULTS_UPDATED
  LEAD_STAGES_UPDATED
  CALL_DISPOSITIONS_UPDATED
  ORGANIZATION_LOCALE_UPDATED
  CONFIG_PROGRESS_UPDATED
  KNOWLEDGE_SOURCE_CREATED
  KNOWLEDGE_DRAFT_UPDATED
  KNOWLEDGE_REPLACEMENT_DRAFT_CREATED
  KNOWLEDGE_VERSION_CONFIRMED
  KNOWLEDGE_SOURCE_ARCHIVED
  KNOWLEDGE_VERSION_RESTORED
}

enum BusinessType {
  SERVICES
  PRODUCTS
  BOTH
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  WEBSITE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum OnboardingStep {
  BUSINESS_BASICS
  CONTACT_LOCATION
  OPERATING_HOURS
  CATALOGUE
  EMPLOYEE_DEFAULTS
  REVIEW
}

/// Generic default for future calling features. Does not grant telephony access.
enum FutureCallingAccessDefault {
  DISABLED
  STANDARD
}

/// Platform business-template keys (Phase 3B). Definitions live in typed server code.
enum BusinessTemplateKey {
  PROFESSIONAL_SERVICES
  HOME_TRADE_SERVICES
  PRODUCT_BUSINESS
  SUBSCRIPTIONS_PLANS
  APPOINTMENT_BASED
  CUSTOM_MIXED
}

enum CustomFieldDataType {
  TEXT
  LONG_TEXT
  NUMBER
  BOOLEAN
  DATE
  SINGLE_SELECT
  MULTI_SELECT
  URL
  EMAIL
  PHONE
}

/// Intended use of a custom-field definition. Values are never stored in Phase 3B.
enum CustomFieldScope {
  BUSINESS
  OFFERING
  PROSPECT
  KNOWLEDGE
}

enum LeadStageClassification {
  NONE
  INITIAL
  WON
  LOST
  TERMINAL
}

enum CallbackAssignmentBehavior {
  UNASSIGNED
  ROUND_ROBIN_PLACEHOLDER
  CREATOR
}

enum RecordingAccessDefault {
  ADMINS_ONLY
  ADMINS_AND_OWNERS
  ROLE_GATED_LATER
}

enum ConfigProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ConfigSection {
  BUSINESS_TEMPLATE
  LOCALE
  SERVICE_AREAS
  AVAILABILITY
  LEAD_STAGES
  CALL_DISPOSITIONS
  CALLBACK_POLICY
  RECORDING_CONSENT
  NOTIFICATIONS
  CUSTOM_FIELDS
  REVIEW
}

/// Tenant root for Phase 2 multi-organization support.
model Organization {
  id                String                    @id @default(cuid())
  name              String
  /// URL-safe unique slug. Normalized at write time; not silently rewritten on rename.
  slug              String                    @unique
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  memberships       Membership[]
  invitations       OrganizationInvitation[]
  auditEvents       OrganizationAuditEvent[]
  activeUsers       User[]                    @relation("UserActiveOrganization")
  businessProfile       BusinessProfile?
  businessLocations     BusinessLocation[]
  operatingHours        OperatingHourInterval[]
  services              BusinessService[]
  products              BusinessProduct[]
  settings              OrganizationSettings?
  onboarding            OrganizationOnboarding?
  templateAssignment    OrganizationTemplateAssignment?
  localeSettings        OrganizationLocaleSettings?
  callbackPolicy        OrganizationCallbackPolicy?
  recordingConsentPolicy OrganizationRecordingConsentPolicy?
  notificationDefaults  OrganizationNotificationDefaults?
  configProgress        OrganizationConfigProgress?
  customFieldDefinitions CustomFieldDefinition[]
  serviceAreas          ServiceArea[]
  holidayClosures       HolidayClosure[]
  leadStageDefaults     LeadStageDefault[]
  callDispositionDefaults CallDispositionDefault[]
  knowledgeSources      KnowledgeSource[]

  @@index([createdAt])
}

/// User membership in an organization. One row per user per organization.
model Membership {
  id                  String           @id @default(cuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                OrganizationRole
  status              MembershipStatus @default(ACTIVE)
  deactivatedAt       DateTime?
  deactivatedByUserId String?
  deactivatedBy       User?            @relation("MembershipDeactivator", fields: [deactivatedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@index([organizationId, role, status])
}

/// Hashed, expiring, single-use organization invitation.
/// Raw tokens are emailed once and never stored.
model OrganizationInvitation {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailNormalized String
  role            OrganizationRole
  tokenHash       String           @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  invitedBy       User             @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId, emailNormalized])
  @@index([expiresAt])
  @@index([organizationId, revokedAt, acceptedAt])
  /// Partial unique index created in Phase 2 migration (one usable invite per org+email).
}

/// Focused audit trail for sensitive Phase 2+ organization actions.
model OrganizationAuditEvent {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actor          User?                    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action         OrganizationAuditAction
  /// Structured, minimal metadata. Never store secrets or raw tokens.
  metadata       Json?
  createdAt      DateTime                 @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Singular business identity and contact configuration for an organization.
/// System organization name/slug remain on Organization; displayName is customer-facing.
model BusinessProfile {
  id                     String                  @id @default(cuid())
  organizationId         String                  @unique
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName              String?
  displayName            String?
  description            String?
  industry               String?
  websiteUrl             String?
  primaryEmail           String?
  /// E.164 when a valid country context exists; otherwise a normalized digit form.
  primaryPhoneE164       String?
  preferredContactMethod PreferredContactMethod?
  /// IANA time zone identifier (e.g. America/Toronto). Never a raw UTC offset.
  timeZone               String?
  businessType           BusinessType?
  /// Optional remote logo URL only — no file upload in Phase 3A.
  logoUrl                String?
  /// Optimistic concurrency token for profile updates.
  version                Int                     @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

/// Organization-owned location. Phase 3A manages one primary location;
/// additional non-primary rows may be added later without schema redesign.
model BusinessLocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String       @default("Primary")
  isPrimary      Boolean      @default(true)
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  /// ISO 3166-1 alpha-2 country code.
  countryCode    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  /// Partial unique index in migration: one primary location per organization.
}

/// Normalized weekly operating-hour intervals.
/// Times are minutes from local midnight; start inclusive, end exclusive.
/// Overnight intervals (end <= start) are rejected. Closed days use isClosed=true
/// with null start/end and sortOrder 0.
model OperatingHourInterval {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dayOfWeek      DayOfWeek
  isClosed       Boolean      @default(false)
  startMinute    Int?
  endMinute      Int?
  sortOrder      Int          @default(0)
  customerNote   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, dayOfWeek, sortOrder])
  @@index([organizationId, dayOfWeek])
}

/// Organization service catalogue entry. Duplicate names are allowed within a tenant.
/// Prefer isActive=false over destructive deletion.
model BusinessService {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  isActive         Boolean      @default(true)
  displayOrder     Int          @default(0)
  priceDescription String?
  durationMinutes  Int?
  category         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, displayOrder])
  @@index([organizationId, isActive, displayOrder])
}

/// Minimal product catalogue for later conversation context.
/// SKU uniqueness is organization-scoped when sku is non-null (partial unique index).
model BusinessProduct {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  isActive         Boolean      @default(true)
  displayOrder     Int          @default(0)
  sku              String?
  priceDescription String?
  category         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, displayOrder])
  @@index([organizationId, isActive, displayOrder])
}

/// Explicit typed employee-access defaults. Cannot grant MEMBER owner/admin powers.
model OrganizationSettings {
  id                         String                      @id @default(cuid())
  organizationId             String                      @unique
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membersCanViewServices     Boolean                     @default(true)
  membersCanViewProducts     Boolean                     @default(true)
  membersCanViewBusinessInfo Boolean                     @default(true)
  futureCallingAccessDefault FutureCallingAccessDefault  @default(DISABLED)
  version                    Int                         @default(0)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
}

/// Authoritative onboarding progress. URL/localStorage are never the source of truth.
model OrganizationOnboarding {
  id                    String          @id @default(cuid())
  organizationId        String          @unique
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status                OnboardingStatus @default(NOT_STARTED)
  currentStep           OnboardingStep  @default(BUSINESS_BASICS)
  /// JSON string array of completed OnboardingStep values (validated in application code).
  completedSteps        Json            @default("[]")
  /// Server-computed readiness for later Phase 3B prerequisites.
  isConfigurationReady  Boolean         @default(false)
  completedAt           DateTime?
  completedByUserId     String?
  completedBy           User?           @relation("OnboardingCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  reopenedAt            DateTime?
  reopenedByUserId      String?
  reopenedBy            User?           @relation("OnboardingReopener", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  version               Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([status])
}

/// Explicit organization selection of a platform business template.
/// Template examples never become customer facts; only confirmed customization is stored.
model OrganizationTemplateAssignment {
  id                       String              @id @default(cuid())
  organizationId           String              @unique
  organization             Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateKey              BusinessTemplateKey
  /// Version of the platform template definition at selection/switch time.
  templateDefinitionVersion Int
  /// Confirmed customization metadata only (labels, enabled suggested keys). Never auto-facts.
  customization            Json                @default("{}")
  selectedByUserId         String?
  selectedBy               User?               @relation("TemplateSelector", fields: [selectedByUserId], references: [id], onDelete: SetNull)
  selectedAt               DateTime            @default(now())
  version                  Int                 @default(0)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
}

/// Locale / language / display preferences. Distinct from BusinessProfile.timeZone.
model OrganizationLocaleSettings {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// BCP 47 locale tag (e.g. en-CA).
  locale                 String       @default("en-CA")
  /// BCP 47 language tag (e.g. en).
  defaultLanguage        String       @default("en")
  dateDisplayPreference  String       @default("locale")
  timeDisplayPreference  String       @default("locale")
  numberDisplayPreference String      @default("locale")
  version                Int          @default(0)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

/// Organization-defined field definitions for later knowledge/CRM phases.
/// Phase 3B stores definitions only — never prospect or knowledge values.
model CustomFieldDefinition {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Stable key unique within organization + scope.
  key              String
  label            String
  description      String?
  dataType         CustomFieldDataType
  required         Boolean            @default(false)
  isActive         Boolean            @default(true)
  displayOrder     Int                @default(0)
  /// Select options as validated JSON string array when applicable.
  options          Json?
  /// Optional validation constraints (min/max/pattern) as schema-validated JSON.
  validation       Json?
  scope            CustomFieldScope   @default(BUSINESS)
  version          Int                @default(0)
  createdByUserId  String?
  createdBy        User?              @relation("CustomFieldCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId  String?
  updatedBy        User?              @relation("CustomFieldUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([organizationId, scope, key])
  @@index([organizationId, scope, displayOrder])
  @@index([organizationId, isActive, displayOrder])
}

/// Geographic / remote service coverage labels. No geometry or geocoding in Phase 3B.
model ServiceArea {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  /// ISO 3166-1 alpha-2 when applicable.
  countryCode    String?
  /// Normalized region/province/state code or label.
  region         String?
  city           String?
  /// Bounded postal/ZIP prefix (digits/letters + optional hyphen), never unbounded wildcards.
  postalPrefix   String?
  isRemote       Boolean      @default(false)
  isActive       Boolean      @default(true)
  displayOrder   Int          @default(0)
  version        Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, displayOrder])
  @@index([organizationId, isActive, displayOrder])
}

/// Exceptional availability separate from weekly OperatingHourInterval rows.
/// Dates are local calendar dates in the organization's IANA timezone.
model HolidayClosure {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Local calendar start date YYYY-MM-DD (organization timezone).
  localDateStart String
  /// Optional inclusive local end date for a bounded range.
  localDateEnd   String?
  isClosedAllDay Boolean      @default(true)
  /// Optional replacement opening intervals [{startMinute,endMinute}] half-open.
  replacementIntervals Json?
  customerNote   String?
  internalLabel  String?
  isActive       Boolean      @default(true)
  version        Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, localDateStart])
  @@index([organizationId, isActive, localDateStart])
}

/// Organization-configured lead stages for later CRM. No prospect records here.
model LeadStageDefault {
  id               String                  @id @default(cuid())
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key              String
  label            String
  isActive         Boolean                 @default(true)
  displayOrder     Int                     @default(0)
  classification   LeadStageClassification @default(NONE)
  isDefault        Boolean                 @default(false)
  version          Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, displayOrder])
}

/// Organization-configured call dispositions for later calling. No call records here.
model CallDispositionDefault {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key              String
  label            String
  isActive         Boolean      @default(true)
  displayOrder     Int          @default(0)
  expectsFollowUp  Boolean      @default(false)
  isTerminal       Boolean      @default(false)
  version          Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, displayOrder])
}

/// Future workflow callback defaults. Not a scheduler.
model OrganizationCallbackPolicy {
  id                         String                      @id @default(cuid())
  organizationId             String                      @unique
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Default suggested callback window length in minutes.
  defaultWindowMinutes       Int                         @default(60)
  maxSuggestedAttempts       Int                         @default(3)
  minSpacingMinutes          Int                         @default(120)
  businessHoursOnly          Boolean                     @default(true)
  defaultAssignmentBehavior  CallbackAssignmentBehavior  @default(UNASSIGNED)
  version                    Int                         @default(0)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
}

/// Recording / transcription / retention / consent policy defaults.
/// Configuration only — not legal approval; recording/transcription default OFF.
model OrganizationRecordingConsentPolicy {
  id                      String                 @id @default(cuid())
  organizationId          String                 @unique
  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordingEnabled        Boolean                @default(false)
  transcriptionEnabled    Boolean                @default(false)
  consentCaptureRequired  Boolean                @default(true)
  /// Placeholder text for later disclosure workflows — not legal advice.
  disclosureTextPlaceholder String?
  /// Retention duration in days within reviewed bounds.
  retentionDays           Int                    @default(30)
  accessDefault           RecordingAccessDefault @default(ADMINS_ONLY)
  reviewRequired          Boolean                @default(true)
  version                 Int                    @default(0)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}

/// Notification and escalation configuration metadata only (no Slack/SMS/telephony).
model OrganizationNotificationDefaults {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  escalationContactLabel  String?
  escalationContactEmail  String?
  /// Enabled notification category keys (validated).
  notificationCategories  Json         @default("[]")
  /// Delivery channels already supported by the app (e.g. in_app, email).
  enabledChannels         Json         @default("[\"in_app\"]")
  /// Optional operational threshold placeholders.
  thresholdPlaceholders   Json         @default("{}")
  version                 Int          @default(0)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

/// Bounded Phase 3B configuration progress. Independent of OrganizationOnboarding.
model OrganizationConfigProgress {
  id                    String               @id @default(cuid())
  organizationId        String               @unique
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status                ConfigProgressStatus @default(NOT_STARTED)
  currentSection        ConfigSection        @default(BUSINESS_TEMPLATE)
  /// JSON string array of completed ConfigSection values.
  completedSections     Json                 @default("[]")
  updatedByUserId       String?
  updatedBy             User?                @relation("ConfigProgressUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  version               Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status])
}

/// How knowledge entered the workspace. Phase 4A persists MANUAL only.
enum KnowledgeInputKind {
  MANUAL
}

/// Source-class labels (KNOW-004). Phase 4A may activate only customer-confirmed facts.
enum KnowledgeSourceCategory {
  CUSTOMER_CONFIRMED_BUSINESS_FACTS
  PLATFORM_MAINTAINED_GUIDANCE
  PROSPECT_EVIDENCE
  CRM_HISTORY
  CALLER_STATEMENTS
  REPRESENTATIVE_NOTES
  LIVE_OPERATIONAL_DATA
  AI_INFERENCES
}

/// Shared Phase 4 lifecycle. Manual 4A writers use DRAFT/ACTIVE/SUPERSEDED/ARCHIVED.
enum KnowledgeLifecycleState {
  DRAFT
  PROCESSING
  NEEDS_ATTENTION
  ACTIVE
  SUPERSEDED
  ARCHIVED
  FAILED
}

/// Organization-owned logical knowledge identity. Versions are immutable once confirmed.
model KnowledgeSource {
  id               String                   @id @default(cuid())
  organizationId   String
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inputKind        KnowledgeInputKind       @default(MANUAL)
  category         KnowledgeSourceCategory
  /// Denormalized title promoted from a version only on confirmation.
  /// Draft updates do not overwrite this while an ACTIVE version exists.
  title            String
  archivedAt       DateTime?
  archivedByUserId String?
  archivedBy       User?                    @relation("KnowledgeSourceArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  createdByUserId  String?
  createdBy        User?                    @relation("KnowledgeSourceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// OCC for source-level archive / restore / replacement-draft creation.
  version          Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  versions         KnowledgeVersion[]

  @@unique([id, organizationId])
  @@index([organizationId, archivedAt])
  @@index([organizationId, category])
  @@index([organizationId, title])
}

/// Immutable confirmed content identity. Drafts may be updated until confirmation.
/// PostgreSQL (not Prisma) also enforces:
/// - composite FKs `supersedesVersionId`/`restoredFromVersionId` → (id, organizationId, sourceId) ON DELETE NO ACTION
/// - effectiveUntil > effectiveFrom when both are set
/// - confirmation fields are all-null or all-present
/// - ACTIVE/SUPERSEDED require confirmation metadata; DRAFT forbids it
model KnowledgeVersion {
  id                          String                  @id @default(cuid())
  organizationId              String
  sourceId                    String
  source                      KnowledgeSource         @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  state                       KnowledgeLifecycleState
  title                       String
  contentChecksum             String
  effectiveFrom               DateTime?               @db.Timestamptz(3)
  effectiveUntil              DateTime?               @db.Timestamptz(3)
  /// OCC for draft updates and confirmation. Frozen after confirmation.
  draftRevision               Int                     @default(0)
  createdByUserId             String?
  createdBy                   User?                   @relation("KnowledgeVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  confirmerUserId             String?
  confirmer                   User?                   @relation("KnowledgeVersionConfirmer", fields: [confirmerUserId], references: [id], onDelete: SetNull)
  confirmedAt                 DateTime?
  confirmationLanguageVersion String?
  /// Previous active version this confirmation replaced, if any.
  supersedesVersionId         String?
  /// Historical version this draft was restored from, if any.
  restoredFromVersionId       String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  sections                    KnowledgeSection[]

  @@unique([id, organizationId])
  @@unique([id, organizationId, sourceId])
  @@index([organizationId, state])
  @@index([sourceId, state])
  @@index([organizationId, state, effectiveFrom])
  @@index([contentChecksum])
}

model KnowledgeSection {
  id             String             @id @default(cuid())
  organizationId String
  sourceId       String
  versionId      String
  version        KnowledgeVersion   @relation(fields: [versionId, organizationId, sourceId], references: [id, organizationId, sourceId], onDelete: Cascade)
  citationKey    String
  title          String
  displayOrder   Int
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  passages       KnowledgePassage[]

  @@unique([versionId, citationKey])
  @@unique([versionId, displayOrder])
  @@unique([id, organizationId, sourceId, versionId])
  @@index([organizationId, versionId, displayOrder])
  @@index([sourceId])
}

model KnowledgePassage {
  id             String           @id @default(cuid())
  organizationId String
  sourceId       String
  versionId      String
  sectionId      String
  section        KnowledgeSection @relation(fields: [sectionId, organizationId, sourceId, versionId], references: [id, organizationId, sourceId, versionId], onDelete: Cascade)
  citationKey    String
  body           String
  displayOrder   Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([sectionId, citationKey])
  @@unique([sectionId, displayOrder])
  @@index([organizationId, versionId])
  @@index([sourceId])
}
