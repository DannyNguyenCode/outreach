# Outreach environment template
# Copy to a local env file and fill in real values:
#   cp .env.example .env.local
#
# Never commit real credentials, Supabase URLs, or Resend API keys.

# ---------------------------------------------------------------------------
# Database (PostgreSQL via Supabase or local)
# ---------------------------------------------------------------------------
# DATABASE_URL is the application connection string. Prefer the pooled
# Supabase connection (port 6543 / pooler hostname, often with
# ?pgbouncer=true) for serverless and long-lived app processes.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# DIRECT_URL is the non-pooled Postgres connection used by Prisma migrations
# and other operations that need session-level features. Prefer the direct
# host (often db.<project>.supabase.co:5432) without pgbouncer.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------------------------------------------------------------------------
# Authentication (Auth.js)
# ---------------------------------------------------------------------------
# Cryptographic secret for JWT/session signing. Generate a long random value
# (at least 32 characters). Never reuse across environments.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Optional. Set to "true" when Auth.js should trust the Host header
# (typical behind Vercel or similar reverse proxies).
# AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Email delivery
# ---------------------------------------------------------------------------
# Resend API key for live delivery. Required by the env schema even when
# AUTH_EMAIL_DELIVERY=mock (use a fake placeholder in local/CI).
RESEND_API_KEY="re_replace_me"

# From address for auth and invitation email.
# Accepts "Name <email@domain>" or a bare email.
AUTH_EMAIL_FROM="Outreach <auth@mail.example.com>"

# Delivery mode: "resend" (live network send) or "mock" (no network send).
# Mock is allowed only in non-production, CI, or Playwright localhost.
# Production / Vercel production always reject mock delivery.
AUTH_EMAIL_DELIVERY="mock"

# Optional. Max wait (ms) for live Resend before failing the send.
# Default 10000. Clamped to 1000–60000 inclusive.
# EMAIL_PROVIDER_TIMEOUT_MS="10000"

# ---------------------------------------------------------------------------
# Application URL
# ---------------------------------------------------------------------------
# Canonical public origin used to build verification, reset, and invitation
# links. No trailing slash required.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Private Business Knowledge documents (server-only)
# ---------------------------------------------------------------------------
# Fixed Outreach-managed Supabase project and private bucket. The service-role
# key must never use a NEXT_PUBLIC_ prefix or be sent to the browser.
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"
KNOWLEDGE_STORAGE_BUCKET="knowledge-documents-private"
# Local/CI only. Production rejects fake adapters.
# KNOWLEDGE_DOCUMENT_ADAPTER_MODE="fake"

# Fail-closed malware scanner HTTP adapter. The endpoint must return a clean
# verdict tied to the exact SHA-256 checksum before extraction can begin.
# MALWARE_SCANNER_URL="https://scanner.internal.example/v1/scan"
# MALWARE_SCANNER_API_KEY="replace-with-scanner-credential"
MALWARE_SCANNER_NAME="configured-http-scanner"
MALWARE_SCANNER_VERSION="v1"

# Secret used by the Staging scheduler to invoke the document worker endpoint.
# Generate at least 32 random characters; do not expose it to clients.
# KNOWLEDGE_WORKER_TOKEN="replace-with-a-long-random-worker-token"

# ---------------------------------------------------------------------------
# Runtime (usually set by the platform; optional locally)
# ---------------------------------------------------------------------------
# NODE_ENV="development"
