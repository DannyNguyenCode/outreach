# Environment variable template for Outreach (Phase 1).
# Copy to `.env.local` for local development. Never commit real secrets.

# Pooled Postgres connection used by the Next.js application (Supabase pooler).
DATABASE_URL="postgresql://postgres.example:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Postgres connection used by Prisma migrations (Supabase direct host).
DIRECT_URL="postgresql://postgres.example:password@db.example.supabase.co:5432/postgres"

# Auth.js session encryption secret (generate a long random string; min 32 chars).
AUTH_SECRET="dev-only-auth-secret-replace-me-32chars"

# Optional: trust Host header in preview/hosted environments (Auth.js v5).
# AUTH_TRUST_HOST="true"

# Resend API key for transactional auth email (verification + password reset).
RESEND_API_KEY="re_dev_replace_with_your_resend_api_key"

# Email delivery mode: "mock" skips network sends; "resend" uses the Resend API.
AUTH_EMAIL_DELIVERY="mock"

# From address for auth email. Use a verified Resend domain in real environments.
AUTH_EMAIL_FROM="Outreach <auth@mail.example.com>"

# Public application origin (safe for the browser). Used to build verification/reset links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
